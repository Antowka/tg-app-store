```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Database files
*.db
*.sqlite
*.sqlite3

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
.coverage
htmlcov/
coverage/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db
```